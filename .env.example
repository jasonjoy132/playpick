# ───────── 플레이픽 서버 환경 변수 ─────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# API 키는 서버(Node.js)에서만 사용되며 브라우저로 전달되지 않습니다.

PORT=4000

# 데이터 소스: demo | live
#  - demo : 데모 데이터(가상의 게임)로 동작
#  - live : 게임물관리위원회 API를 실제로 호출. 호출이 실패하면 오류 화면을 표시(데모로 몰래 대체하지 않음)
DATA_SOURCE=demo

# ── 게임물관리위원회 게임 검색 Open API ──
# 가이드: https://www.grac.or.kr/OpenBook/OpenAPIGuide.aspx
# 가이드에 인증키 변수가 없어 키 없이 호출합니다. 주소를 바꿀 필요가 없으면 비워 두세요(기본값 사용).
GRAC_API_URL=https://www.grac.or.kr/WebService/GameSearchSvc.asmx/game
# 한 번에 가져올 건수(최대 1000)와 가져올 최대 페이지 수 (호출 제한이 문서에 없어 기본은 1페이지)
GRAC_DISPLAY=1000
GRAC_MAX_PAGES=1
# 조회 기간(선택, yyyy-mm-dd). 비우면 기간 조건 없이 요청
GRAC_START_DATE=
GRAC_END_DATE=
# 응답 캐시 시간(초)
GRAC_CACHE_TTL=3600

# ── 국내 게임 DB API ──
# 원페이저에 서비스명이 명시되어 있지 않아 아직 연결 대상이 정해지지 않았습니다.
# 서비스가 정해지면 server/providers/krGameDbProvider.js 의 매핑 함수를 구현하세요.
KR_GAME_DB_API_URL=
KR_GAME_DB_API_KEY=

# ── IGDB API (게임위 API에 없는 게임 보완용) ──
# Twitch 개발자 콘솔(dev.twitch.tv/console/apps)에서 앱 등록 후 발급받은 값을 넣으세요.
# Client Secret은 비밀번호와 같습니다. 이 .env 파일에만 넣고 채팅·코드·git에 올리지 마세요.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# 목록(첫 화면·추천·검색)에서 숨길 IGDB 게임 상태, 쉼표로 구분. 비우면 Offline(서비스 종료)만 숨김
# 사용 가능 값 예: Offline(서비스 종료), Delisted(판매 중단), Cancelled(개발 취소), Rumored(출시 미정)
IGDB_HIDE_STATUSES=Offline

# ── DeepL API (영어 게임 소개 → 한국어 번역) ──
# https://www.deepl.com/pro-api 에서 'DeepL API Free' 가입 후 발급받은 인증키를 넣으세요(무료 키는 ':fx'로 끝남).
# 비워 두면 번역하지 않고 원문(영어)을 그대로 보여 줍니다.
DEEPL_API_KEY=
# 엔드포인트를 직접 지정할 때만 사용 (기본: 키 형식에 따라 api-free.deepl.com 또는 api.deepl.com)
DEEPL_API_URL=

# ── 회원·찜·리뷰 ──
# 저장 파일 (기본: .data/playpick.db, git 제외)
DB_FILE=
# 사이트 주소 (비밀번호 재설정 메일 링크에 사용)
APP_BASE_URL=http://localhost:4000

# ── 메일 발송: Brevo (아이디 찾기·비밀번호 재설정) ──
# https://www.brevo.com 가입 → SMTP & API → API Keys 에서 키 발급, Senders 에서 보내는 사람 이메일 인증
BREVO_API_KEY=
# Brevo에서 인증한 보내는 사람 이메일
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=PlayPick
# 개발용: true 로 하면 메일 대신 서버 터미널에 내용 출력 (실서비스에서는 사용 금지)
MAIL_DEV_LOG=false

# ── RAWG API (게임 상세의 평균 플레이 시간) ──
# https://rawg.io/apidocs 에서 키 발급. 무료: 월 20,000건, 비상업 프로젝트. 페이지에 RAWG 출처 링크 표시(자동)
# 비워 두면 플레이 시간은 '정보 없음'으로 표시
RAWG_API_KEY=

# ── App Store 검색 (게임위 전용 모바일 게임의 아이콘·App Store 링크, 키 불필요) ──
# 끄려면 false
APPSTORE_LOOKUP=true

# ── 추천 인원 AI 추정 (Google Gemini API) ──
# https://aistudio.google.com/apikey 에서 키 발급 (무료 사용량 있음)
# IGDB 협동 인원 등 실제 데이터로 추천 인원을 정할 수 없는 게임만 AI 추정 대상이고, 화면에 'AI 추정'으로 표시합니다.
# AI 추정은 npm run prefill:players 로 '미리' 받아 server/data/party-size.json 에 저장하고, 서버는 그 파일만 읽습니다.
# (키는 이 스크립트를 돌릴 때만 필요. 정리 안 된 게임은 인원 '정보 없음')
GEMINI_API_KEY=
# 모델 이름(선택). 비우면 gemini-flash-lite-latest (점검 결과 1~2초로 가장 빠름). npm run check:gemini 로 모델별 속도 확인
GEMINI_MODEL=
# on 으로 두면 파일에 없는 게임을 검색할 때 그때그때 AI에게 물음(느려질 수 있음). 기본 off
AI_PLAYERS_LIVE=off
# 게임위 게임 중 AI가 상태를 '모름'이라고 한 게임은 기본으로 목록에서 숨깁니다(서비스 중·App Store에 있는 게임만 보임). off 면 '모름'도 보임
HIDE_UNKNOWN_GRAC=on
# GRAC_INDEX=off 로 두면 '나만의 게임 찾기'에서 IGDB에 없는 게임위 게임 검색을 끕니다.

# ── 관리자 (게임 제보 승인·거절) ──
# 이 이메일로 가입한 계정으로 로그인하면 사용자 메뉴에 '제보 관리 (관리자)'가 보입니다. 여러 명이면 쉼표로 구분.
# ⚠ 가입할 때 이메일 인증을 하지 않으므로, 이 이메일로 '먼저' 직접 가입해 두세요(다른 사람이 같은 이메일로 가입 못 하게).
ADMIN_EMAILS=
